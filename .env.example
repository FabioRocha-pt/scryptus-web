# Copiar para .env.local (desenvolvimento) ou definir no painel do Vercel.

# ── Obrigatórias ────────────────────────────────────────────────────
# Sanity (públicas — vão para o browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Endereço público do site, sem barra final (sitemap, canónicos, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.scryptus1-caboverde.com

# ── Formulários ─────────────────────────────────────────────────────
# Token de escrita do Sanity com permissão "Editor" (sanity.io/manage → API).
# Sem ele, o formulário de orçamento e a newsletter não conseguem gravar.
SANITY_API_WRITE_TOKEN=

# Aviso por email de cada pedido (opcional, via resend.com).
# Sem estas três variáveis os pedidos ficam apenas no Studio.
RESEND_API_KEY=
CONTACT_EMAIL_TO=info@scryptus1-caboverde.com
CONTACT_EMAIL_FROM=site@scryptus1-caboverde.com

# ── Opcional ────────────────────────────────────────────────────────
# Versão da API do Sanity (por defeito 2026-06-19)
# NEXT_PUBLIC_SANITY_API_VERSION=
